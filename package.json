{
  "name": "cosmu",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22 <26"
  },
  "scripts": {
    "dev": "pnpm --filter @cosmu/web dev",
    "build": "pnpm --filter @cosmu/web build",
    "start": "pnpm --filter @cosmu/web start",
    "typecheck": "pnpm --filter @cosmu/web typecheck",
    "verify": "pnpm typecheck && pnpm build",
    "demo:data": "python3 scripts/landing/build_cibr_demo.py"
  }
}
