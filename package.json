{
  "name": "cosmu",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22 <26"
  },
  "scripts": {
    "dev": "pnpm --filter @cosmu/web dev",
    "build": "pnpm --filter @cosmu/web build",
    "start": "pnpm --filter @cosmu/web start",
    "typecheck": "pnpm --filter @cosmu/web typecheck",
    "verify": "pnpm typecheck && pnpm build",
    "research": "cd scripts/landing && python3 hypotheses.py",
    "research:spikes": "cd scripts/landing && python3 news_spikes.py",
    "demo:data": "cd scripts/landing && python3 build_showcase.py"
  }
}
