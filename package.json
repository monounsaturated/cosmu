{
  "name": "cosmu",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22 <26"
  },
  "scripts": {
    "build": "pnpm contracts:generate && pnpm --filter @cosmu/contracts-ts build && pnpm --filter @cosmu/web build",
    "build:all": "pnpm -r build",
    "build:railway": "pnpm --filter @cosmu/web build",
    "contracts:generate": "python3 scripts/generate_contracts.py",
    "db:reset:local": "node scripts/reset-local-db.mjs",
    "dev": "pnpm contracts:generate && pnpm --parallel --filter @cosmu/web dev",
    "engine:api": "PYTHONPATH=apps/engine python3 -m cosmu.api.app",
    "engine:test": "PYTHONPATH=apps/engine python3 -m pytest apps/engine/tests",
    "start": "pnpm --filter @cosmu/web start",
    "start:api": "PYTHONPATH=apps/engine python3 -m cosmu.api.app",
    "start:web": "pnpm --filter @cosmu/web start",
    "lint": "pnpm -r lint",
    "prepare": "node scripts/setup-hooks.mjs",
    "setup:hooks": "node scripts/setup-hooks.mjs",
    "naming:check": "python3 scripts/check_naming.py",
    "modal:secret": "python3 scripts/sync_modal_secret.py",
    "modal:gate": "modal run apps/engine/remote/app.py --job gate_sweep",
    "modal:ingest": "modal run apps/engine/remote/app.py --job ingest",
    "typecheck": "pnpm --filter @cosmu/contracts-ts typecheck && pnpm --filter @cosmu/web typecheck",
    "verify": "pnpm naming:check && pnpm contracts:generate && pnpm engine:test && pnpm typecheck && pnpm build",
    "verify:remote": "git push -u origin HEAD"
  }
}
