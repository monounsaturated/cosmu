# ====== BASE DE DONNÉES ======
# Format Supabase (Transaction pooler, port 6543 recommandé)
# IMPORTANT: Garder le même format (postgresql://user:password@host:6543/postgres)
# IMPORTANT: Ne pas utiliser de crochets [ ] dans l'URL. Le mot de passe doit être URL-encodé.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cosmu
# Set false for a local non-SSL Postgres. Leave true/empty for Supabase pooler.
DATABASE_SSL=false

# ====== CONFIGURATION GLOBALE ======
API_PORT=4000
# Server-only URL used by Next.js routes/server components to call the Railway API.
API_BASE_URL=http://localhost:4000

# ====== SÉCURITÉ & CORS ======
# Remplace par une vraie clé secrète en production (min 32 chars)
API_SECRET_KEY=cle_secrete_de_developpement_locale_tres_longue

# Optional. One production/custom origin, or leave empty (Vercel previews are still allowed — see README).
WEB_BASE_URL=
# Optional. Comma-separated extra allowed browser origins (e.g. custom domain on Vercel).
# CORS_EXTRA_ORIGINS=https://app.example.com
# Default: allow https://*.vercel.app previews. Set to false to disable.
# CORS_ALLOW_VERCEL_PREVIEWS=true
# Optional. Same as old "open CORS" when WEB_BASE_URL was unset — not recommended for public APIs.
# CORS_ALLOW_ANY_ORIGIN=false

# ====== APIS EXTERNES ======
XAI_API_KEY=
NOUS_API_KEY=
# Optional. Defaults to https://portal.nousresearch.com/v1
NOUS_BASE_URL=
OPENAI_API_KEY=
# Optional. Leave blank for OpenAI default.
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
# Optional. Defaults to https://api.anthropic.com/v1
ANTHROPIC_BASE_URL=
HUGGINGFACE_API_KEY=
# Optional. Defaults to https://router.huggingface.co/v1
HUGGINGFACE_BASE_URL=
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Testnet keys (from https://testnet.binance.vision/) — used when bot mode=testnet
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
SLACK_WEBHOOK_URL=

# ====== BACKGROUND AUTOMATION ======
# Enable these only on the Railway API service when you want production automation.
SCHEDULER_ENABLED=false
GUARDIAN_ENABLED=false
