# ====== HOW TO USE THIS TEMPLATE ======
# Copy to .env.local (gitignored) and fill. Each key lives in up to 3 places — keep them in sync:
#   • .env.local        → the SOURCE you copy from (local dev + `modal run` auth)
#   • Railway dashboard  → the always-on backend (engine API + crons)
#   • Modal secret       → `pnpm modal:secret` pushes the runtime keys from .env.local (no hand-typing)
# The FREE cross-asset gate runs with ZERO keys. Keys only unlock paid/LLM/extra-data paths.
# Operator jurisdiction = FR/EU: prefer EU regions for Supabase + Railway.

# ====== BASE DE DONNÉES ======
# Format Supabase (Transaction pooler, port 6543 recommandé)
# IMPORTANT: Garder le même format (postgresql://user:password@host:6543/postgres)
# IMPORTANT: Ne pas utiliser de crochets [ ] dans l'URL. Le mot de passe doit être URL-encodé.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cosmu
# Set false for a local non-SSL Postgres. Leave true/empty for Supabase pooler.
DATABASE_SSL=false

# ====== PROFIL D'ENVIRONNEMENT (APP_ENV) ======
# APP_ENV picks WHICH env file the engine loads (and maps to the typed `environment`):
#   dev        → .env.local        (default; maps to environment=local)
#   test       → .env.test.local   (sqlite, NO keys; maps to environment=test)
#   qa         → .env.qa.local     (supabase placeholder; maps to environment=production)
#   production → NO file at all — process env only (secrets injected by the platform, never committed)
# The FREE cross-asset gate (POST /research/cross-asset-gate) needs ZERO API keys to run — the
# synthetic fallback runs offline, and every free provider (Kraken/Bybit/Yahoo/Coinglass/CBOE/GDELT)
# is keyless. Keys below are only for the paid/LLM paths.
APP_ENV=dev

# ====== CONFIGURATION GLOBALE ======
API_PORT=4000
# Server-only URL used by Next.js routes/server components to call the Railway API.
API_BASE_URL=http://localhost:4000

# ====== SÉCURITÉ & CORS ======
# Remplace par une vraie clé secrète en production (min 32 chars)
API_SECRET_KEY=cle_secrete_de_developpement_locale_tres_longue

# Optional. One production/custom origin, or leave empty (Vercel previews are still allowed — see README).
WEB_BASE_URL=
# Optional. Comma-separated extra allowed browser origins (e.g. custom domain on Vercel).
# CORS_EXTRA_ORIGINS=https://app.example.com
# Default: allow https://*.vercel.app previews. Set to false to disable.
# CORS_ALLOW_VERCEL_PREVIEWS=true
# Optional. Same as old "open CORS" when WEB_BASE_URL was unset — not recommended for public APIs.
# CORS_ALLOW_ANY_ORIGIN=false

# ====== APIS EXTERNES ======
XAI_API_KEY=
NOUS_API_KEY=
# Optional. Defaults to https://portal.nousresearch.com/v1
NOUS_BASE_URL=
OPENAI_API_KEY=
# Optional. Leave blank for OpenAI default.
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
# Optional. Defaults to https://api.anthropic.com/v1
ANTHROPIC_BASE_URL=
HUGGINGFACE_API_KEY=
# Optional. Defaults to https://router.huggingface.co/v1
HUGGINGFACE_BASE_URL=

# ====== ALT-DATA, LLM ROUTER & SIGNAL KEYS ======
# OpenRouter: one gateway, many models (Qwen/DeepSeek/Grok/Claude/GPT). `:free` tier by default.
# Optional fallback when XAI_API_KEY is unset. Goes in: .env.local + Railway + Modal secret.
OPENROUTER_API_KEY=
# FRED (free key): macro series (rates, yields, DXY, credit spreads). https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# LunarCrush (PAID plan as of 2026 — no free tier): social/sentiment feed. The provider is already wired;
# setting this key activates the Social pillar + lunarcrush features. Empty = degrades honestly (returns []).
LUNARCRUSH_API_KEY=
# Polymarket: a real market token id (NOT a secret) → prediction-market odds usable as features now.
POLYMARKET_TOKEN=
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Testnet keys (from https://testnet.binance.vision/) — used when bot mode=testnet
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
SLACK_WEBHOOK_URL=

# ====== MODAL (HEAVY-COMPUTE LANE) ======
# Lets `modal run` authenticate non-interactively (Claude Code / cloud sessions). Get them from
# https://modal.com/settings/tokens. For a normal laptop you can instead just run `modal setup` once
# (writes ~/.modal.toml) and leave these blank.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# NOTE: the RUNTIME keys the Modal jobs use (DATABASE_URL, XAI_API_KEY, FRED_API_KEY, …) are NOT read from
# this file by Modal — they live in the Modal secret `cosmu-engine`. Sync them from .env.local in one step:
#   python3 scripts/sync_modal_secret.py   (alias: pnpm modal:secret)
