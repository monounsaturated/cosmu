{
  "name": "cosmu",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  // Secrets (API keys, broker credentials, etc.) are injected via
  // GitHub Codespaces Secrets — set them in repo or org Settings → Codespaces → Secrets.
  "postCreateCommand": "pip install -e apps/engine[dev] && npm i -g pnpm && pnpm install --frozen-lockfile",
  "forwardPorts": [8000, 3000],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  }
}
