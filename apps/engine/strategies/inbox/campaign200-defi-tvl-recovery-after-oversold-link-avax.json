{
  "name": "defi_tvl_recovery_after_oversold_link_avax",
  "rationale": "Thesis: when a DeFi-heavy alt (LINK/AVAX) is oversold (low RSI) AND TVL crosses back up, that combination flags real capital returning to the ecosystem rather than a dead-cat bounce; positive medium momentum confirms the turn has legs. Disconfirmer: gate RSI-oversold-only entry (no TVL cross) on LINK/AVAX \u2014 if mean-reversion alone explains the bounce, the TVL up-cross is decorative and this is just dip-buying.",
  "catalyst": "defi_tvl crosses up while asset RSI is recovering from oversold and momentum has turned positive",
  "universe": {
    "venues": [
      "binance"
    ],
    "asset_classes": [
      "crypto"
    ],
    "min_liquidity_usd": 10000000,
    "min_instruments": 5
  },
  "horizon": {
    "bar_size": "1d",
    "min_hold_days": 5,
    "max_hold_days": 22
  },
  "entry": [
    {
      "feature": {
        "name": "defi_tvl"
      },
      "op": "cross_up",
      "threshold": {
        "param": "tvl_cross"
      }
    },
    {
      "feature": {
        "name": "rsi"
      },
      "op": "between",
      "threshold": {
        "param": "rsi_band"
      }
    },
    {
      "feature": {
        "name": "ret_Nd",
        "lookback": {
          "param": "mom_lb"
        }
      },
      "op": "gt",
      "threshold": {
        "param": "mom_min"
      }
    }
  ],
  "exit": {
    "stop_loss": {
      "param": "stop"
    },
    "take_profit": {
      "param": "tp"
    },
    "time_stop_days": {
      "param": "time_stop"
    },
    "signal_exits": []
  },
  "risk": {
    "max_concurrent_positions": 5,
    "max_position_pct": 0.2,
    "conviction": 0.5
  },
  "param_space": {
    "tvl_cross": {
      "kind": "float",
      "lo": -0.5,
      "hi": 0.5
    },
    "rsi_band": {
      "kind": "float",
      "lo": 30.0,
      "hi": 55.0
    },
    "mom_lb": {
      "kind": "int",
      "lo": 3,
      "hi": 12,
      "step": 1
    },
    "mom_min": {
      "kind": "float",
      "lo": -0.02,
      "hi": 0.04
    },
    "stop": {
      "kind": "float",
      "lo": 0.06,
      "hi": 0.2
    },
    "tp": {
      "kind": "float",
      "lo": 0.1,
      "hi": 0.4
    },
    "time_stop": {
      "kind": "int",
      "lo": 5,
      "hi": 25,
      "step": 1
    }
  },
  "direction": 1,
  "funding_feature": null
}