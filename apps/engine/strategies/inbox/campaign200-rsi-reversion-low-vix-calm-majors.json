{
  "name": "rsi_reversion_low_vix_calm_majors",
  "rationale": "Reversion only works when fear is contained: buy RSI oversold while vix_level is below a fitted calm ceiling. Thesis: in calm vol, oversold prints mean-revert; in high-vol panics they keep falling. DISCONFIRMER: a bb_z<floor requirement forces the dip to be a genuine statistical extension, and the low-VIX gate is the control \u2014 if removing the VIX ceiling (i.e. allowing high-VIX) leaves the edge intact, the gate is decorative and it is plain buy-the-dip.",
  "catalyst": "RSI oversold during a low-VIX calm window",
  "universe": {
    "venues": [
      "binance"
    ],
    "asset_classes": [
      "crypto"
    ],
    "min_liquidity_usd": 10000000,
    "min_instruments": 5
  },
  "horizon": {
    "bar_size": "1d",
    "min_hold_days": 1,
    "max_hold_days": 8
  },
  "entry": [
    {
      "feature": {
        "name": "rsi"
      },
      "op": "lt",
      "threshold": {
        "param": "rsi_os"
      }
    },
    {
      "feature": {
        "name": "vix_level"
      },
      "op": "lt",
      "threshold": {
        "param": "vix_calm"
      }
    },
    {
      "feature": {
        "name": "bb_z"
      },
      "op": "lt",
      "threshold": {
        "param": "bbz_floor"
      }
    }
  ],
  "exit": {
    "stop_loss": {
      "param": "stop"
    },
    "take_profit": {
      "param": "tp"
    },
    "time_stop_days": {
      "param": "time_stop"
    },
    "signal_exits": [
      {
        "feature": {
          "name": "bb_z"
        },
        "op": "gt",
        "threshold": {
          "param": "bbz_exit"
        }
      }
    ]
  },
  "risk": {
    "max_concurrent_positions": 5,
    "max_position_pct": 0.2,
    "conviction": 0.5
  },
  "param_space": {
    "rsi_os": {
      "kind": "float",
      "lo": 22,
      "hi": 40
    },
    "vix_calm": {
      "kind": "float",
      "lo": 14,
      "hi": 24
    },
    "bbz_floor": {
      "kind": "float",
      "lo": -3.0,
      "hi": -1.2
    },
    "bbz_exit": {
      "kind": "float",
      "lo": -0.3,
      "hi": 0.8
    },
    "stop": {
      "kind": "float",
      "lo": 0.05,
      "hi": 0.18
    },
    "tp": {
      "kind": "float",
      "lo": 0.08,
      "hi": 0.35
    },
    "time_stop": {
      "kind": "int",
      "lo": 3,
      "hi": 20,
      "step": 1
    }
  },
  "direction": 1,
  "funding_feature": null
}