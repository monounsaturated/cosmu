{
  "name": "bbz_revert_fear_eth_sol_alt_dip",
  "rationale": "Higher-beta majors (ETH/SOL/AVAX/LINK) overshoot the lower band hardest under fear; a bb_z recovery during fear captures the sharper sentiment snap-back. Disconfirmer: fear_greed must be below the fear cap; if the same bb_z cross_up on these alts reverts equally in greed/neutral, the fear gate adds no information and the result is plain high-beta dip-buying.",
  "catalyst": "bb_z crosses up out of oversold on high-beta alts while fear_greed is depressed",
  "universe": {
    "venues": [
      "binance"
    ],
    "asset_classes": [
      "crypto"
    ],
    "min_liquidity_usd": 10000000,
    "min_instruments": 5
  },
  "horizon": {
    "bar_size": "1d",
    "min_hold_days": 3,
    "max_hold_days": 14
  },
  "entry": [
    {
      "feature": {
        "name": "bb_z"
      },
      "op": "cross_up",
      "threshold": {
        "param": "bbz_recover"
      }
    },
    {
      "feature": {
        "name": "fear_greed"
      },
      "op": "lt",
      "threshold": {
        "param": "fear_max"
      }
    }
  ],
  "exit": {
    "stop_loss": {
      "param": "stop"
    },
    "take_profit": {
      "param": "tp"
    },
    "time_stop_days": {
      "param": "time_stop"
    },
    "signal_exits": [
      {
        "feature": {
          "name": "bb_z"
        },
        "op": "cross_up",
        "threshold": {
          "param": "bbz_exit"
        }
      }
    ]
  },
  "risk": {
    "max_concurrent_positions": 4,
    "max_position_pct": 0.2,
    "conviction": 0.5
  },
  "param_space": {
    "bbz_recover": {
      "kind": "float",
      "lo": -2.8,
      "hi": -1.2
    },
    "fear_max": {
      "kind": "float",
      "lo": 18,
      "hi": 38
    },
    "bbz_exit": {
      "kind": "float",
      "lo": 0.2,
      "hi": 1.4
    },
    "stop": {
      "kind": "float",
      "lo": 0.07,
      "hi": 0.2
    },
    "tp": {
      "kind": "float",
      "lo": 0.12,
      "hi": 0.4
    },
    "time_stop": {
      "kind": "int",
      "lo": 4,
      "hi": 20,
      "step": 1
    }
  },
  "direction": 1,
  "funding_feature": null
}