{
  "name": "vix_calm_cross_risk_on_majors",
  "rationale": "VIX crossing DOWN through a calming level signals an equity-vol regime easing that spills into crypto risk appetite. Thesis: arm long majors on vix_level cross_down. Disconfirmer: gate with fear_greed < a fitted ceiling so we are NOT already in euphoria \u2014 if the edge requires extreme greed it is just chasing a hot tape, not capturing the vol-regime de-risking that the VIX cross is supposed to represent.",
  "catalyst": "VIX crosses down through a calming threshold",
  "universe": {
    "venues": [
      "binance"
    ],
    "asset_classes": [
      "crypto"
    ],
    "min_liquidity_usd": 10000000,
    "min_instruments": 5
  },
  "horizon": {
    "bar_size": "1d",
    "min_hold_days": 3,
    "max_hold_days": 20
  },
  "entry": [
    {
      "feature": {
        "name": "vix_level"
      },
      "op": "cross_down",
      "threshold": {
        "param": "vix_cross"
      }
    },
    {
      "feature": {
        "name": "fear_greed"
      },
      "op": "lt",
      "threshold": {
        "param": "fg_ceiling"
      }
    }
  ],
  "exit": {
    "stop_loss": {
      "param": "stop"
    },
    "take_profit": {
      "param": "tp"
    },
    "time_stop_days": {
      "param": "time_stop"
    },
    "signal_exits": []
  },
  "risk": {
    "max_concurrent_positions": 5,
    "max_position_pct": 0.2,
    "conviction": 0.5
  },
  "param_space": {
    "vix_cross": {
      "kind": "float",
      "lo": 14.0,
      "hi": 28.0
    },
    "fg_ceiling": {
      "kind": "float",
      "lo": 45.0,
      "hi": 75.0
    },
    "stop": {
      "kind": "float",
      "lo": 0.05,
      "hi": 0.2
    },
    "tp": {
      "kind": "float",
      "lo": 0.08,
      "hi": 0.4
    },
    "time_stop": {
      "kind": "int",
      "lo": 4,
      "hi": 20,
      "step": 1
    }
  },
  "direction": 1,
  "funding_feature": null
}