{
  "name": "vol_expansion_trend_confirm_adx",
  "rationale": "Realized-vol expansion that coincides with rising trend strength is a regime shift toward a directional move rather than choppy two-sided volatility. Thesis: arm long on vol_realized cross_up confirmed by trend. Disconfirmer: require adx > a fitted floor \u2014 if the edge holds when ADX is low (no trend) then the vol cross is firing on directionless chop and the 'regime shift' claim is false; demanding trend proves the expansion is directional.",
  "catalyst": "realized vol expands while trend strength is present",
  "universe": {
    "venues": [
      "binance"
    ],
    "asset_classes": [
      "crypto"
    ],
    "min_liquidity_usd": 10000000,
    "min_instruments": 5
  },
  "horizon": {
    "bar_size": "1d",
    "min_hold_days": 3,
    "max_hold_days": 18
  },
  "entry": [
    {
      "feature": {
        "name": "vol_realized"
      },
      "op": "cross_up",
      "threshold": {
        "param": "vol_cross"
      }
    },
    {
      "feature": {
        "name": "adx"
      },
      "op": "gt",
      "threshold": {
        "param": "adx_floor"
      }
    }
  ],
  "exit": {
    "stop_loss": {
      "param": "stop"
    },
    "take_profit": {
      "param": "tp"
    },
    "time_stop_days": {
      "param": "time_stop"
    },
    "signal_exits": []
  },
  "risk": {
    "max_concurrent_positions": 5,
    "max_position_pct": 0.2,
    "conviction": 0.5
  },
  "param_space": {
    "vol_cross": {
      "kind": "float",
      "lo": 0.015,
      "hi": 0.07
    },
    "adx_floor": {
      "kind": "float",
      "lo": 18.0,
      "hi": 35.0
    },
    "stop": {
      "kind": "float",
      "lo": 0.05,
      "hi": 0.2
    },
    "tp": {
      "kind": "float",
      "lo": 0.08,
      "hi": 0.4
    },
    "time_stop": {
      "kind": "int",
      "lo": 4,
      "hi": 18,
      "step": 1
    }
  },
  "direction": 1,
  "funding_feature": null
}