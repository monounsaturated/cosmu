{
  "name": "dxy_weakness_defi_inflow_rotation",
  "rationale": "Thesis: a weakening dollar (low DXY) loosens global liquidity, and when capital simultaneously rotates ON-chain (DeFi TVL crossing up) it confirms real risk-on flow into crypto rather than a passive USD-denominated rerate. Buy ETH/SOL/AVAX/LINK/BNB which are the DeFi-levered names. Disconfirmer: run macro-only (dxy weak) and on-chain-only (defi_tvl cross up) controls; the conjunction must beat both legs, else there is no cross-asset interaction and we are just long a falling dollar.",
  "catalyst": "DeFi TVL crosses up while DXY sits in a weak-dollar band",
  "universe": {
    "venues": [
      "binance"
    ],
    "asset_classes": [
      "crypto"
    ],
    "min_liquidity_usd": 10000000,
    "min_instruments": 5
  },
  "horizon": {
    "bar_size": "1d",
    "min_hold_days": 3,
    "max_hold_days": 20
  },
  "entry": [
    {
      "feature": {
        "name": "defi_tvl"
      },
      "op": "cross_up",
      "threshold": {
        "param": "tvl_cross"
      }
    },
    {
      "feature": {
        "name": "dxy"
      },
      "op": "lt",
      "threshold": {
        "param": "dxy_max"
      }
    }
  ],
  "exit": {
    "stop_loss": {
      "param": "stop"
    },
    "take_profit": {
      "param": "tp"
    },
    "time_stop_days": {
      "param": "time_stop"
    },
    "signal_exits": [
      {
        "feature": {
          "name": "dxy"
        },
        "op": "gt",
        "threshold": {
          "param": "dxy_exit"
        }
      }
    ]
  },
  "risk": {
    "max_concurrent_positions": 5,
    "max_position_pct": 0.2,
    "conviction": 0.5
  },
  "param_space": {
    "tvl_cross": {
      "kind": "float",
      "lo": 0.0,
      "hi": 0.0
    },
    "dxy_max": {
      "kind": "float",
      "lo": 98,
      "hi": 105
    },
    "dxy_exit": {
      "kind": "float",
      "lo": 105,
      "hi": 110
    },
    "stop": {
      "kind": "float",
      "lo": 0.05,
      "hi": 0.2
    },
    "tp": {
      "kind": "float",
      "lo": 0.1,
      "hi": 0.4
    },
    "time_stop": {
      "kind": "int",
      "lo": 4,
      "hi": 25,
      "step": 1
    }
  },
  "direction": 1,
  "funding_feature": null
}