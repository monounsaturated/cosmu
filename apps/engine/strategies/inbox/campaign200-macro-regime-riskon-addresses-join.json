{
  "name": "macro_regime_riskon_addresses_join",
  "rationale": "Thesis: when the composite macro_regime sits in a risk-on band (favorable cross-asset backdrop) and on-chain demand simultaneously expands (BTC active addresses crossing up), the macro tailwind and the bottoms-up demand signal align for a durable advance. Disconfirmer: a macro-regime-only control; the active-address cross must add expectancy, else the on-chain leg is subsumed by the macro composite and brings no orthogonality.",
  "catalyst": "BTC active addresses cross up while macro_regime is risk-on",
  "universe": {
    "venues": [
      "binance"
    ],
    "asset_classes": [
      "crypto"
    ],
    "min_liquidity_usd": 10000000,
    "min_instruments": 5
  },
  "horizon": {
    "bar_size": "1d",
    "min_hold_days": 3,
    "max_hold_days": 20
  },
  "entry": [
    {
      "feature": {
        "name": "btc_active_addresses"
      },
      "op": "cross_up",
      "threshold": {
        "param": "aa_cross"
      }
    },
    {
      "feature": {
        "name": "macro_regime"
      },
      "op": "gt",
      "threshold": {
        "param": "regime_min"
      }
    }
  ],
  "exit": {
    "stop_loss": {
      "param": "stop"
    },
    "take_profit": {
      "param": "tp"
    },
    "time_stop_days": {
      "param": "time_stop"
    },
    "signal_exits": [
      {
        "feature": {
          "name": "macro_regime"
        },
        "op": "lt",
        "threshold": {
          "param": "regime_exit"
        }
      }
    ]
  },
  "risk": {
    "max_concurrent_positions": 5,
    "max_position_pct": 0.2,
    "conviction": 0.5
  },
  "param_space": {
    "aa_cross": {
      "kind": "float",
      "lo": 0.0,
      "hi": 0.0
    },
    "regime_min": {
      "kind": "float",
      "lo": 0.0,
      "hi": 0.5
    },
    "regime_exit": {
      "kind": "float",
      "lo": -0.5,
      "hi": 0.0
    },
    "stop": {
      "kind": "float",
      "lo": 0.06,
      "hi": 0.2
    },
    "tp": {
      "kind": "float",
      "lo": 0.1,
      "hi": 0.4
    },
    "time_stop": {
      "kind": "int",
      "lo": 4,
      "hi": 22,
      "step": 1
    }
  },
  "direction": 1,
  "funding_feature": null
}