{
  "name": "greed_regime_adx_trend_strength",
  "rationale": "Inside a greed regime (fear_greed high), a strong directional trend (high adx) is more likely to be a durable risk-on impulse than a blow-off. Greed gates ADX-trend entries. Disconfirmer: an adx-only control (adx>thresh, no greed gate) \u2014 if it matches performance, the edge is trend-strength not regime, and the greed condition is dead weight.",
  "catalyst": "high fear_greed coincides with rising ADX trend strength",
  "universe": {
    "venues": [
      "binance"
    ],
    "asset_classes": [
      "crypto"
    ],
    "min_liquidity_usd": 10000000,
    "min_instruments": 5
  },
  "horizon": {
    "bar_size": "1d",
    "min_hold_days": 4,
    "max_hold_days": 20
  },
  "entry": [
    {
      "feature": {
        "name": "fear_greed"
      },
      "op": "gt",
      "threshold": {
        "param": "greed_floor"
      }
    },
    {
      "feature": {
        "name": "adx"
      },
      "op": "gt",
      "threshold": {
        "param": "adx_floor"
      }
    }
  ],
  "exit": {
    "stop_loss": {
      "param": "stop"
    },
    "take_profit": {
      "param": "tp"
    },
    "time_stop_days": {
      "param": "time_stop"
    },
    "signal_exits": [
      {
        "feature": {
          "name": "adx"
        },
        "op": "lt",
        "threshold": {
          "param": "adx_exit"
        }
      }
    ]
  },
  "risk": {
    "max_concurrent_positions": 5,
    "max_position_pct": 0.2,
    "conviction": 0.5
  },
  "param_space": {
    "greed_floor": {
      "kind": "float",
      "lo": 55,
      "hi": 72
    },
    "adx_floor": {
      "kind": "float",
      "lo": 20,
      "hi": 35
    },
    "adx_exit": {
      "kind": "float",
      "lo": 12,
      "hi": 20
    },
    "stop": {
      "kind": "float",
      "lo": 0.06,
      "hi": 0.2
    },
    "tp": {
      "kind": "float",
      "lo": 0.1,
      "hi": 0.4
    },
    "time_stop": {
      "kind": "int",
      "lo": 4,
      "hi": 20,
      "step": 1
    }
  },
  "direction": 1,
  "funding_feature": null
}