{
  "name": "rsi_oversold_vix_calm_no_downtrend_eth_bnb",
  "rationale": "Reversion of shallow oversold dips in calm vol: buy RSI oversold on ETH/BNB when vix_level is below a calm ceiling AND the recent N-day return is above a fitted floor (not a freefall). Thesis: in calm regimes, mild oversold pullbacks revert. DISCONFIRMER: the ret_Nd>floor control proves it is noise-reversion not knife-catching \u2014 if the strategy only earns when ret_Nd is deeply negative, it is a downtrend bet (momentum), not RSI reversion; and the low-VIX gate must matter on its own.",
  "catalyst": "RSI oversold + shallow recent drawdown during a low-VIX window",
  "universe": {
    "venues": [
      "binance"
    ],
    "asset_classes": [
      "crypto"
    ],
    "min_liquidity_usd": 10000000,
    "min_instruments": 5
  },
  "horizon": {
    "bar_size": "1d",
    "min_hold_days": 1,
    "max_hold_days": 6
  },
  "entry": [
    {
      "feature": {
        "name": "rsi"
      },
      "op": "lt",
      "threshold": {
        "param": "rsi_os"
      }
    },
    {
      "feature": {
        "name": "vix_level"
      },
      "op": "lt",
      "threshold": {
        "param": "vix_calm"
      }
    },
    {
      "feature": {
        "name": "ret_Nd",
        "lookback": {
          "param": "ret_lb"
        }
      },
      "op": "gt",
      "threshold": {
        "param": "ret_floor"
      }
    }
  ],
  "exit": {
    "stop_loss": {
      "param": "stop"
    },
    "take_profit": {
      "param": "tp"
    },
    "time_stop_days": {
      "param": "time_stop"
    },
    "signal_exits": [
      {
        "feature": {
          "name": "rsi"
        },
        "op": "gt",
        "threshold": {
          "param": "rsi_exit"
        }
      }
    ]
  },
  "risk": {
    "max_concurrent_positions": 2,
    "max_position_pct": 0.2,
    "conviction": 0.5
  },
  "param_space": {
    "rsi_os": {
      "kind": "float",
      "lo": 25,
      "hi": 42
    },
    "vix_calm": {
      "kind": "float",
      "lo": 14,
      "hi": 23
    },
    "ret_lb": {
      "kind": "int",
      "lo": 3,
      "hi": 10,
      "step": 1
    },
    "ret_floor": {
      "kind": "float",
      "lo": -0.15,
      "hi": -0.02
    },
    "rsi_exit": {
      "kind": "float",
      "lo": 50,
      "hi": 66
    },
    "stop": {
      "kind": "float",
      "lo": 0.05,
      "hi": 0.15
    },
    "tp": {
      "kind": "float",
      "lo": 0.06,
      "hi": 0.25
    },
    "time_stop": {
      "kind": "int",
      "lo": 3,
      "hi": 15,
      "step": 1
    }
  },
  "direction": 1,
  "funding_feature": null
}