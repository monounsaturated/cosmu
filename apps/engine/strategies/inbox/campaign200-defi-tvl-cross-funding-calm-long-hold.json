{
  "name": "defi_tvl_cross_funding_calm_long_hold",
  "rationale": "Thesis: a TVL up-cross is most trustworthy when perp funding is calm (not crowded-long), because the inflow reflects spot/locked capital rather than leveraged froth \u2014 so confluence of TVL cross + bounded funding + positive momentum, held longer, rides organic accumulation. Disconfirmer: gate funding-calm-only entry (funding_rate between band, no TVL cross) \u2014 if the low-crowding regime alone produces the return, the TVL cross adds nothing and this is a de-crowding trade, not a capital-inflow edge.",
  "catalyst": "defi_tvl up-cross while funding_rate is in a calm band and momentum is positive",
  "universe": {
    "venues": [
      "binance"
    ],
    "asset_classes": [
      "crypto"
    ],
    "min_liquidity_usd": 10000000,
    "min_instruments": 5
  },
  "horizon": {
    "bar_size": "1d",
    "min_hold_days": 7,
    "max_hold_days": 25
  },
  "entry": [
    {
      "feature": {
        "name": "defi_tvl"
      },
      "op": "cross_up",
      "threshold": {
        "param": "tvl_cross"
      }
    },
    {
      "feature": {
        "name": "funding_rate"
      },
      "op": "between",
      "threshold": {
        "param": "fund_band"
      }
    },
    {
      "feature": {
        "name": "ret_Nd",
        "lookback": {
          "param": "mom_lb"
        }
      },
      "op": "gt",
      "threshold": {
        "param": "mom_min"
      }
    }
  ],
  "exit": {
    "stop_loss": {
      "param": "stop"
    },
    "take_profit": {
      "param": "tp"
    },
    "time_stop_days": {
      "param": "time_stop"
    },
    "signal_exits": [
      {
        "feature": {
          "name": "defi_tvl"
        },
        "op": "cross_down",
        "threshold": {
          "param": "tvl_exit"
        }
      }
    ]
  },
  "risk": {
    "max_concurrent_positions": 5,
    "max_position_pct": 0.2,
    "conviction": 0.5
  },
  "param_space": {
    "tvl_cross": {
      "kind": "float",
      "lo": -0.5,
      "hi": 0.5
    },
    "tvl_exit": {
      "kind": "float",
      "lo": -0.5,
      "hi": 0.5
    },
    "fund_band": {
      "kind": "float",
      "lo": -0.003,
      "hi": 0.006
    },
    "mom_lb": {
      "kind": "int",
      "lo": 5,
      "hi": 20,
      "step": 1
    },
    "mom_min": {
      "kind": "float",
      "lo": 0.0,
      "hi": 0.05
    },
    "stop": {
      "kind": "float",
      "lo": 0.06,
      "hi": 0.2
    },
    "tp": {
      "kind": "float",
      "lo": 0.12,
      "hi": 0.4
    },
    "time_stop": {
      "kind": "int",
      "lo": 7,
      "hi": 25,
      "step": 1
    }
  },
  "direction": 1,
  "funding_feature": null
}