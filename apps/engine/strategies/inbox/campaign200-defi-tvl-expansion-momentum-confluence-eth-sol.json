{
  "name": "defi_tvl_expansion_momentum_confluence_eth_sol",
  "rationale": "Thesis: rising DeFi TVL is real capital being locked into smart-contract chains; when TVL crosses up AND price momentum is already positive, the two confirm a genuine capital-inflow uptrend rather than a thin price pop. Disconfirmer: run ETH/SOL momentum-only (ret_Nd cross_up with NO TVL gate) over the same window \u2014 if it earns the same after-fee P&L, the defi_tvl cross adds nothing and is just a momentum proxy.",
  "catalyst": "defi_tvl crosses up its trailing level while medium-horizon return is positive",
  "universe": {
    "venues": [
      "binance"
    ],
    "asset_classes": [
      "crypto"
    ],
    "min_liquidity_usd": 10000000,
    "min_instruments": 5
  },
  "horizon": {
    "bar_size": "1d",
    "min_hold_days": 3,
    "max_hold_days": 20
  },
  "entry": [
    {
      "feature": {
        "name": "defi_tvl"
      },
      "op": "cross_up",
      "threshold": {
        "param": "tvl_cross"
      }
    },
    {
      "feature": {
        "name": "ret_Nd",
        "lookback": {
          "param": "mom_lb"
        }
      },
      "op": "gt",
      "threshold": {
        "param": "mom_min"
      }
    }
  ],
  "exit": {
    "stop_loss": {
      "param": "stop"
    },
    "take_profit": {
      "param": "tp"
    },
    "time_stop_days": {
      "param": "time_stop"
    },
    "signal_exits": [
      {
        "feature": {
          "name": "defi_tvl"
        },
        "op": "cross_down",
        "threshold": {
          "param": "tvl_exit"
        }
      }
    ]
  },
  "risk": {
    "max_concurrent_positions": 5,
    "max_position_pct": 0.2,
    "conviction": 0.5
  },
  "param_space": {
    "tvl_cross": {
      "kind": "float",
      "lo": -0.5,
      "hi": 0.5
    },
    "tvl_exit": {
      "kind": "float",
      "lo": -0.5,
      "hi": 0.5
    },
    "mom_lb": {
      "kind": "int",
      "lo": 5,
      "hi": 20,
      "step": 1
    },
    "mom_min": {
      "kind": "float",
      "lo": 0.0,
      "hi": 0.08
    },
    "stop": {
      "kind": "float",
      "lo": 0.05,
      "hi": 0.2
    },
    "tp": {
      "kind": "float",
      "lo": 0.08,
      "hi": 0.4
    },
    "time_stop": {
      "kind": "int",
      "lo": 3,
      "hi": 25,
      "step": 1
    }
  },
  "direction": 1,
  "funding_feature": null
}