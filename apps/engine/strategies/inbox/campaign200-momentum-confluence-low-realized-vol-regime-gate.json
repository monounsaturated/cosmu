    "venues": [
      "binance"
    ],
    "asset_classes": [
      "crypto"
    ],
    "min_liquidity_usd": 10000000,
    "min_instruments": 5
  },
  "horizon": {
    "bar_size": "1d",
    "min_hold_days": 5,
    "max_hold_days": 22
  },
  "entry": [
    {
      "feature": {
        "name": "ret_Nd",
        "lookback": {
          "param": "lb_short"
        }
      },
      "op": "gt",
      "threshold": {
        "param": "thr_short"
      }
    },
    {
      "feature": {
        "name": "ret_Nd",
        "lookback": {
          "param": "lb_med"
        }
      },
      "op": "gt",
      "threshold": {
        "param": "thr_med"
      }
    },
    {
      "feature": {
        "name": "vol_realized"
      },
      "op": "lt",
      "threshold": {
        "param": "vol_max"
      }
    }
  ],
  "exit": {
