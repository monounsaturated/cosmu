{
  "name": "greed_regime_macro_riskon_confluence",
  "rationale": "Crypto greed regimes that COINCIDE with a risk-on macro_regime composite are more likely to persist than greed driven purely by crypto-internal reflexivity. We require greed AND a high macro_regime reading AND positive momentum. Disconfirmer: a control dropping the macro_regime gate. If macro confluence adds no return, the macro feature is dead weight and we are running single-factor greed-momentum.",
  "catalyst": "crypto greed aligned with a risk-on macro composite",
  "universe": {
    "venues": [
      "binance"
    ],
    "asset_classes": [
      "crypto"
    ],
    "min_liquidity_usd": 10000000,
    "min_instruments": 5
  },
  "horizon": {
    "bar_size": "1d",
    "min_hold_days": 5,
    "max_hold_days": 22
  },
  "entry": [
    {
      "feature": {
        "name": "fear_greed"
      },
      "op": "gt",
      "threshold": {
        "param": "greed_floor"
      }
    },
    {
      "feature": {
        "name": "macro_regime"
      },
      "op": "gt",
      "threshold": {
        "param": "macro_floor"
      }
    },
    {
      "feature": {
        "name": "ret_Nd",
        "lookback": {
          "param": "mom_lb"
        }
      },
      "op": "gt",
      "threshold": {
        "param": "mom_floor"
      }
    }
  ],
  "exit": {
    "stop_loss": {
      "param": "stop"
    },
    "take_profit": {
      "param": "tp"
    },
    "time_stop_days": {
      "param": "time_stop"
    },
    "signal_exits": [
      {
        "feature": {
          "name": "fear_greed"
        },
        "op": "lt",
        "threshold": {
          "param": "greed_exit"
        }
      }
    ]
  },
  "risk": {
    "max_concurrent_positions": 5,
    "max_position_pct": 0.2,
    "conviction": 0.5
  },
  "param_space": {
    "greed_floor": {
      "kind": "float",
      "lo": 55,
      "hi": 70
    },
    "greed_exit": {
      "kind": "float",
      "lo": 40,
      "hi": 50
    },
    "macro_floor": {
      "kind": "float",
      "lo": 0.0,
      "hi": 0.6
    },
    "mom_floor": {
      "kind": "float",
      "lo": 0.0,
      "hi": 0.04
    },
    "mom_lb": {
      "kind": "int",
      "lo": 5,
      "hi": 12,
      "step": 1
    },
    "stop": {
      "kind": "float",
      "lo": 0.06,
      "hi": 0.2
    },
    "tp": {
      "kind": "float",
      "lo": 0.12,
      "hi": 0.4
    },
    "time_stop": {
      "kind": "int",
      "lo": 5,
      "hi": 22,
      "step": 1
    }
  },
  "direction": 1,
  "funding_feature": null
}