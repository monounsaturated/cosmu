{
  "name": "greed_regime_low_funding_uncrowded",
  "rationale": "Greed-regime trend continuation is safest when leverage is NOT already crowded long \u2014 so we require greed plus a funding_rate below a ceiling (perp longs not yet euphoric) plus positive momentum. Disconfirmer: a control without the funding filter. If euphoric-funding greed and calm-funding greed perform identically, funding_rate is irrelevant and the edge reduces to greed-armed momentum.",
  "catalyst": "greed regime with positive momentum but uncrowded (low) funding",
  "universe": {
    "venues": [
      "binance"
    ],
    "asset_classes": [
      "crypto"
    ],
    "min_liquidity_usd": 10000000,
    "min_instruments": 5
  },
  "horizon": {
    "bar_size": "1d",
    "min_hold_days": 3,
    "max_hold_days": 16
  },
  "entry": [
    {
      "feature": {
        "name": "fear_greed"
      },
      "op": "gt",
      "threshold": {
        "param": "greed_floor"
      }
    },
    {
      "feature": {
        "name": "funding_rate"
      },
      "op": "lt",
      "threshold": {
        "param": "funding_ceiling"
      }
    },
    {
      "feature": {
        "name": "ret_Nd",
        "lookback": {
          "param": "mom_lb"
        }
      },
      "op": "gt",
      "threshold": {
        "param": "mom_floor"
      }
    }
  ],
  "exit": {
    "stop_loss": {
      "param": "stop"
    },
    "take_profit": {
      "param": "tp"
    },
    "time_stop_days": {
      "param": "time_stop"
    },
    "signal_exits": [
      {
        "feature": {
          "name": "fear_greed"
        },
        "op": "lt",
        "threshold": {
          "param": "greed_exit"
        }
      }
    ]
  },
  "risk": {
    "max_concurrent_positions": 5,
    "max_position_pct": 0.2,
    "conviction": 0.5
  },
  "param_space": {
    "greed_floor": {
      "kind": "float",
      "lo": 55,
      "hi": 72
    },
    "greed_exit": {
      "kind": "float",
      "lo": 38,
      "hi": 50
    },
    "funding_ceiling": {
      "kind": "float",
      "lo": 0.0,
      "hi": 0.008
    },
    "mom_floor": {
      "kind": "float",
      "lo": 0.0,
      "hi": 0.03
    },
    "mom_lb": {
      "kind": "int",
      "lo": 3,
      "hi": 8,
      "step": 1
    },
    "stop": {
      "kind": "float",
      "lo": 0.05,
      "hi": 0.18
    },
    "tp": {
      "kind": "float",
      "lo": 0.1,
      "hi": 0.36
    },
    "time_stop": {
      "kind": "int",
      "lo": 3,
      "hi": 16,
      "step": 1
    }
  },
  "direction": 1,
  "funding_feature": null
}