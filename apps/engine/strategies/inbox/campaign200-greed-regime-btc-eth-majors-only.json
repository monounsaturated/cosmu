{
  "name": "greed_regime_btc_eth_majors_only",
  "rationale": "Greed regimes are cleanest in the highest-liquidity majors where sentiment-driven inflows are real, not reflexive alt churn. We arm momentum continuation only on BTC/ETH inside greed. Disconfirmer: a no-greed momentum control on the same majors \u2014 if ret_3d>0 alone trades equally, the greed regime is decorative and we are long momentum-in-disguise.",
  "catalyst": "fear_greed elevated and BTC/ETH show positive short-term momentum",
  "universe": {
    "venues": [
      "binance"
    ],
    "asset_classes": [
      "crypto"
    ],
    "min_liquidity_usd": 50000000,
    "min_instruments": 5
  },
  "horizon": {
    "bar_size": "1d",
    "min_hold_days": 3,
    "max_hold_days": 12
  },
  "entry": [
    {
      "feature": {
        "name": "fear_greed"
      },
      "op": "gt",
      "threshold": {
        "param": "greed_floor"
      }
    },
    {
      "feature": {
        "name": "ret_Nd",
        "lookback": {
          "param": "mom_lb"
        }
      },
      "op": "gt",
      "threshold": {
        "param": "mom_floor"
      }
    }
  ],
  "exit": {
    "stop_loss": {
      "param": "stop"
    },
    "take_profit": {
      "param": "tp"
    },
    "time_stop_days": {
      "param": "time_stop"
    },
    "signal_exits": [
      {
        "feature": {
          "name": "fear_greed"
        },
        "op": "lt",
        "threshold": {
          "param": "greed_exit"
        }
      }
    ]
  },
  "risk": {
    "max_concurrent_positions": 2,
    "max_position_pct": 0.2,
    "conviction": 0.5
  },
  "param_space": {
    "greed_floor": {
      "kind": "float",
      "lo": 58,
      "hi": 75
    },
    "greed_exit": {
      "kind": "float",
      "lo": 38,
      "hi": 52
    },
    "mom_floor": {
      "kind": "float",
      "lo": 0.0,
      "hi": 0.03
    },
    "mom_lb": {
      "kind": "int",
      "lo": 2,
      "hi": 5,
      "step": 1
    },
    "stop": {
      "kind": "float",
      "lo": 0.05,
      "hi": 0.18
    },
    "tp": {
      "kind": "float",
      "lo": 0.08,
      "hi": 0.35
    },
    "time_stop": {
      "kind": "int",
      "lo": 3,
      "hi": 12,
      "step": 1
    }
  },
  "direction": 1,
  "funding_feature": null
}