{
  "name": "dollar_strength_overdone_reversal_oversold",
  "rationale": "Thesis: when DXY is stretched HIGH (dollar strength overdone, mean-reversion likely) AND the crypto asset is itself oversold (low RSI), the coming dollar relief rally should disproportionately lift the most beaten-down crypto. This is a cross-asset reversal, not trend-following. Disconfirmer: a DXY-overdone-only control vs an RSI-oversold-only control; the conjunction must beat both, proving the cross-asset interaction matters and it is not just single-asset dip-buying or dollar fading.",
  "catalyst": "DXY in a stretched-high band while RSI is oversold",
  "universe": {
    "venues": [
      "binance"
    ],
    "asset_classes": [
      "crypto"
    ],
    "min_liquidity_usd": 10000000,
    "min_instruments": 5
  },
  "horizon": {
    "bar_size": "1d",
    "min_hold_days": 2,
    "max_hold_days": 12
  },
  "entry": [
    {
      "feature": {
        "name": "dxy"
      },
      "op": "gt",
      "threshold": {
        "param": "dxy_min"
      }
    },
    {
      "feature": {
        "name": "rsi"
      },
      "op": "lt",
      "threshold": {
        "param": "rsi_max"
      }
    }
  ],
  "exit": {
    "stop_loss": {
      "param": "stop"
    },
    "take_profit": {
      "param": "tp"
    },
    "time_stop_days": {
      "param": "time_stop"
    },
    "signal_exits": [
      {
        "feature": {
          "name": "rsi"
        },
        "op": "gt",
        "threshold": {
          "param": "rsi_exit"
        }
      }
    ]
  },
  "risk": {
    "max_concurrent_positions": 5,
    "max_position_pct": 0.2,
    "conviction": 0.5
  },
  "param_space": {
    "dxy_min": {
      "kind": "float",
      "lo": 104,
      "hi": 110
    },
    "rsi_max": {
      "kind": "float",
      "lo": 25,
      "hi": 40
    },
    "rsi_exit": {
      "kind": "float",
      "lo": 55,
      "hi": 70
    },
    "stop": {
      "kind": "float",
      "lo": 0.05,
      "hi": 0.18
    },
    "tp": {
      "kind": "float",
      "lo": 0.08,
      "hi": 0.3
    },
    "time_stop": {
      "kind": "int",
      "lo": 3,
      "hi": 15,
      "step": 1
    }
  },
  "direction": 1,
  "funding_feature": null
}