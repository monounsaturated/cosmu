{
  "name": "greed_regime_momentum_continuation",
  "rationale": "Persistent greed (fear_greed above a high floor) marks a risk-on REGIME where positive 5d momentum tends to continue rather than mean-revert. We arm trend-following ONLY inside greed. Disconfirmer: a control without the greed gate (ret_5d>0 alone) \u2014 if that control trades equally well, greed adds no information and this is just momentum-in-disguise.",
  "catalyst": "fear_greed sits above a high floor while 5-day return is positive",
  "universe": {
    "venues": [
      "binance"
    ],
    "asset_classes": [
      "crypto"
    ],
    "min_liquidity_usd": 10000000,
    "min_instruments": 5
  },
  "horizon": {
    "bar_size": "1d",
    "min_hold_days": 3,
    "max_hold_days": 15
  },
  "entry": [
    {
      "feature": {
        "name": "fear_greed"
      },
      "op": "gt",
      "threshold": {
        "param": "greed_floor"
      }
    },
    {
      "feature": {
        "name": "ret_Nd",
        "lookback": {
          "param": "mom_lb"
        }
      },
      "op": "gt",
      "threshold": {
        "param": "mom_floor"
      }
    }
  ],
  "exit": {
    "stop_loss": {
      "param": "stop"
    },
    "take_profit": {
      "param": "tp"
    },
    "time_stop_days": {
      "param": "time_stop"
    },
    "signal_exits": [
      {
        "feature": {
          "name": "fear_greed"
        },
        "op": "lt",
        "threshold": {
          "param": "greed_exit"
        }
      }
    ]
  },
  "risk": {
    "max_concurrent_positions": 5,
    "max_position_pct": 0.2,
    "conviction": 0.5
  },
  "param_space": {
    "greed_floor": {
      "kind": "float",
      "lo": 55,
      "hi": 75
    },
    "greed_exit": {
      "kind": "float",
      "lo": 35,
      "hi": 50
    },
    "mom_floor": {
      "kind": "float",
      "lo": 0.0,
      "hi": 0.04
    },
    "mom_lb": {
      "kind": "int",
      "lo": 3,
      "hi": 7,
      "step": 1
    },
    "stop": {
      "kind": "float",
      "lo": 0.05,
      "hi": 0.2
    },
    "tp": {
      "kind": "float",
      "lo": 0.08,
      "hi": 0.4
    },
    "time_stop": {
      "kind": "int",
      "lo": 3,
      "hi": 15,
      "step": 1
    }
  },
  "direction": 1,
  "funding_feature": null
}