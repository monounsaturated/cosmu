{
  "name": "defi_tvl_cross_low_vol_quiet_accumulation",
  "rationale": "Thesis: capital quietly accumulating (TVL up-cross) during a low realized-volatility tape is the cleanest accumulation signal \u2014 no panic, no froth \u2014 so confluence of TVL cross + bounded-low vol_realized + positive momentum should precede a controlled markup. Disconfirmer: gate low-realized-vol-only entry (vol_realized lt, no TVL cross) over the same window \u2014 if the quiet-tape risk-on filter alone delivers the return, the TVL cross is redundant and this is just low-vol momentum continuation.",
  "catalyst": "defi_tvl up-cross while realized volatility is below a fitted ceiling and momentum is positive",
  "universe": {
    "venues": [
      "binance"
    ],
    "asset_classes": [
      "crypto"
    ],
    "min_liquidity_usd": 10000000,
    "min_instruments": 6
  },
  "horizon": {
    "bar_size": "1d",
    "min_hold_days": 5,
    "max_hold_days": 22
  },
  "entry": [
    {
      "feature": {
        "name": "defi_tvl"
      },
      "op": "cross_up",
      "threshold": {
        "param": "tvl_cross"
      }
    },
    {
      "feature": {
        "name": "vol_realized"
      },
      "op": "lt",
      "threshold": {
        "param": "vol_ceiling"
      }
    },
    {
      "feature": {
        "name": "ret_Nd",
        "lookback": {
          "param": "mom_lb"
        }
      },
      "op": "gt",
      "threshold": {
        "param": "mom_min"
      }
    }
  ],
  "exit": {
    "stop_loss": {
      "param": "stop"
    },
    "take_profit": {
      "param": "tp"
    },
    "time_stop_days": {
      "param": "time_stop"
    },
    "signal_exits": []
  },
  "risk": {
    "max_concurrent_positions": 5,
    "max_position_pct": 0.2,
    "conviction": 0.5
  },
  "param_space": {
    "tvl_cross": {
      "kind": "float",
      "lo": -0.5,
      "hi": 0.5
    },
    "vol_ceiling": {
      "kind": "float",
      "lo": 0.02,
      "hi": 0.06
    },
    "mom_lb": {
      "kind": "int",
      "lo": 4,
      "hi": 16,
      "step": 1
    },
    "mom_min": {
      "kind": "float",
      "lo": 0.0,
      "hi": 0.05
    },
    "stop": {
      "kind": "float",
      "lo": 0.05,
      "hi": 0.18
    },
    "tp": {
      "kind": "float",
      "lo": 0.1,
      "hi": 0.4
    },
    "time_stop": {
      "kind": "int",
      "lo": 5,
      "hi": 25,
      "step": 1
    }
  },
  "direction": 1,
  "funding_feature": null
}