        }
      },
      "op": "gt",
      "threshold": {
        "param": "thr_short"
      }
    },
    {
      "feature": {
        "name": "ret_Nd",
        "lookback": {
          "param": "lb_med"
        }
      },
      "op": "gt",
      "threshold": {
        "param": "thr_med"
      }
    },
    {
