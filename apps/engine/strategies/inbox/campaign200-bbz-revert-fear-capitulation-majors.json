{
  "name": "bbz_revert_fear_capitulation_majors",
  "rationale": "When price snaps back UP through the lower Bollinger band (bb_z cross_up from oversold) DURING extreme fear, the stretch was sentiment-driven capitulation that mean-reverts. Disconfirmer: gate ONLY fires when fear_greed is below the fear threshold; if the identical bb_z cross_up reverts equally in neutral/greed, the fear gate is inert and this is just buy-the-dip, not regime-conditional reversion.",
  "catalyst": "bb_z crosses up out of oversold while fear_greed is in capitulation territory",
  "universe": {
    "venues": [
      "binance"
    ],
    "asset_classes": [
      "crypto"
    ],
    "min_liquidity_usd": 10000000,
    "min_instruments": 5
  },
  "horizon": {
    "bar_size": "1d",
    "min_hold_days": 2,
    "max_hold_days": 12
  },
  "entry": [
    {
      "feature": {
        "name": "bb_z"
      },
      "op": "cross_up",
      "threshold": {
        "param": "bbz_recover"
      }
    },
    {
      "feature": {
        "name": "fear_greed"
      },
      "op": "lt",
      "threshold": {
        "param": "fear_max"
      }
    }
  ],
  "exit": {
    "stop_loss": {
      "param": "stop"
    },
    "take_profit": {
      "param": "tp"
    },
    "time_stop_days": {
      "param": "time_stop"
    },
    "signal_exits": [
      {
        "feature": {
          "name": "bb_z"
        },
        "op": "cross_up",
        "threshold": {
          "param": "bbz_exit"
        }
      }
    ]
  },
  "risk": {
    "max_concurrent_positions": 5,
    "max_position_pct": 0.2,
    "conviction": 0.5
  },
  "param_space": {
    "bbz_recover": {
      "kind": "float",
      "lo": -2.5,
      "hi": -1.0
    },
    "fear_max": {
      "kind": "float",
      "lo": 15,
      "hi": 35
    },
    "bbz_exit": {
      "kind": "float",
      "lo": 0.0,
      "hi": 1.2
    },
    "stop": {
      "kind": "float",
      "lo": 0.05,
      "hi": 0.2
    },
    "tp": {
      "kind": "float",
      "lo": 0.08,
      "hi": 0.4
    },
    "time_stop": {
      "kind": "int",
      "lo": 3,
      "hi": 18,
      "step": 1
    }
  },
  "direction": 1,
  "funding_feature": null
}