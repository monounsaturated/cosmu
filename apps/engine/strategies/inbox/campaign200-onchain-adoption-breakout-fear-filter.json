{
  "name": "onchain_adoption_breakout_fear_filter",
  "rationale": "Thesis: a fresh upturn in BTC on-chain usage (active addresses crossing up) marks genuine network adoption that precedes spot appreciation, but only when sentiment is NOT already euphoric (fear_greed not yet greedy) so we buy real adoption rather than froth. Disconfirmer: gate against a pure price-momentum control (ret_5d>0); if returns are identical to momentum alone, the active-address cross is decorative and the edge is fake.",
  "catalyst": "BTC active addresses cross up while fear_greed still below the greed band",
  "universe": {
    "venues": [
      "binance"
    ],
    "asset_classes": [
      "crypto"
    ],
    "min_liquidity_usd": 10000000,
    "min_instruments": 5
  },
  "horizon": {
    "bar_size": "1d",
    "min_hold_days": 2,
    "max_hold_days": 15
  },
  "entry": [
    {
      "feature": {
        "name": "btc_active_addresses"
      },
      "op": "cross_up",
      "threshold": {
        "param": "aa_cross"
      }
    },
    {
      "feature": {
        "name": "fear_greed"
      },
      "op": "lt",
      "threshold": {
        "param": "fg_max"
      }
    }
  ],
  "exit": {
    "stop_loss": {
      "param": "stop"
    },
    "take_profit": {
      "param": "tp"
    },
    "time_stop_days": {
      "param": "time_stop"
    },
    "signal_exits": [
      {
        "feature": {
          "name": "fear_greed"
        },
        "op": "gt",
        "threshold": {
          "param": "fg_exit"
        }
      }
    ]
  },
  "risk": {
    "max_concurrent_positions": 5,
    "max_position_pct": 0.2,
    "conviction": 0.5
  },
  "param_space": {
    "aa_cross": {
      "kind": "float",
      "lo": 0.0,
      "hi": 0.0
    },
    "fg_max": {
      "kind": "float",
      "lo": 45,
      "hi": 70
    },
    "fg_exit": {
      "kind": "float",
      "lo": 75,
      "hi": 90
    },
    "stop": {
      "kind": "float",
      "lo": 0.05,
      "hi": 0.2
    },
    "tp": {
      "kind": "float",
      "lo": 0.08,
      "hi": 0.4
    },
    "time_stop": {
      "kind": "int",
      "lo": 3,
      "hi": 20,
      "step": 1
    }
  },
  "direction": 1,
  "funding_feature": null
}