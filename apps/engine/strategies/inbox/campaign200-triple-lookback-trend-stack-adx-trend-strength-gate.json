{
  "name": "Triple-Lookback Trend Stack \u2014 ADX Trend-Strength Gate",
  "rationale": "Thesis: a stacked agreement across three lookbacks (5d, 12d, 25d all positive) is only tradeable when the trend is structurally strong, measured by ADX above a fitted level. Disconfirmer: ADX gating must improve outcomes over the unfiltered triple-stack \u2014 if low-ADX (chop) confluence performs identically, ADX is a no-op and the edge is just multi-window momentum.",
  "catalyst": "Three return windows all positive while ADX confirms a real trend regime.",
  "universe": {
    "venues": [
      "binance"
    ],
    "asset_classes": [
      "crypto"
    ],
    "min_liquidity_usd": 10000000,
    "min_instruments": 5
  },
  "horizon": {
    "bar_size": "1d",
    "min_hold_days": 4,
    "max_hold_days": 22
  },
  "entry": [
    {
      "feature": {
        "name": "ret_Nd",
        "lookback": {
          "param": "lb_fast"
        }
      },
      "op": "gt",
      "threshold": {
        "param": "thr_fast"
      }
    },
    {
      "feature": {
        "name": "ret_Nd",
        "lookback": {
          "param": "lb_mid"
        }
      },
      "op": "gt",
      "threshold": {
        "param": "thr_mid"
      }
    },
    {
      "feature": {
        "name": "ret_Nd",
        "lookback": {
          "param": "lb_slow"
        }
      },
      "op": "gt",
      "threshold": {
        "param": "thr_slow"
      }
    },
    {
      "feature": {
        "name": "adx"
      },
      "op": "gt",
      "threshold": {
        "param": "adx_min"
      }
    }
  ],
  "exit": {
    "stop_loss": {
      "param": "stop"
    },
    "take_profit": {
      "param": "tp"
    },
    "time_stop_days": {
      "param": "time_stop"
    },
    "signal_exits": [
      {
        "feature": {
          "name": "adx"
        },
        "op": "lt",
        "threshold": {
          "param": "adx_exit"
        }
      }
    ]
  },
  "risk": {
    "max_concurrent_positions": 5,
    "max_position_pct": 0.2,
    "conviction": 0.5
  },
  "param_space": {
    "lb_fast": {
      "kind": "int",
      "lo": 3,
      "hi": 6,
      "step": 1
    },
    "lb_mid": {
      "kind": "int",
      "lo": 10,
      "hi": 14,
      "step": 1
    },
    "lb_slow": {
      "kind": "int",
      "lo": 20,
      "hi": 30,
      "step": 1
    },
    "thr_fast": {
      "kind": "float",
      "lo": 0.0,
      "hi": 0.04
    },
    "thr_mid": {
      "kind": "float",
      "lo": 0.0,
      "hi": 0.08
    },
    "thr_slow": {
      "kind": "float",
      "lo": 0.0,
      "hi": 0.12
    },
    "adx_min": {
      "kind": "float",
      "lo": 20.0,
      "hi": 35.0
    },
    "adx_exit": {
      "kind": "float",
      "lo": 12.0,
      "hi": 22.0
    },
    "stop": {
      "kind": "float",
      "lo": 0.05,
      "hi": 0.2
    },
    "tp": {
      "kind": "float",
      "lo": 0.08,
      "hi": 0.4
    },
    "time_stop": {
      "kind": "int",
      "lo": 3,
      "hi": 25,
      "step": 1
    }
  },
  "direction": 1,
  "funding_feature": null
}