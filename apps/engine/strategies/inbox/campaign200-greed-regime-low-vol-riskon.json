{
  "name": "greed_regime_low_vol_riskon",
  "rationale": "A clean risk-on greed regime should be CALM (low realized vol), distinguishing healthy trend continuation from frothy, high-vol blow-off greed. We require greed plus below-threshold realized vol plus positive momentum. Disconfirmer: a control without the vol filter. If calm and frothy greed regimes perform the same, vol_realized is irrelevant and the edge collapses to greed-armed momentum.",
  "catalyst": "greed regime with subdued realized volatility and positive momentum",
  "universe": {
    "venues": [
      "binance"
    ],
    "asset_classes": [
      "crypto"
    ],
    "min_liquidity_usd": 10000000,
    "min_instruments": 5
  },
  "horizon": {
    "bar_size": "1d",
    "min_hold_days": 4,
    "max_hold_days": 18
  },
  "entry": [
    {
      "feature": {
        "name": "fear_greed"
      },
      "op": "gt",
      "threshold": {
        "param": "greed_floor"
      }
    },
    {
      "feature": {
        "name": "vol_realized"
      },
      "op": "lt",
      "threshold": {
        "param": "vol_ceiling"
      }
    },
    {
      "feature": {
        "name": "ret_Nd",
        "lookback": {
          "param": "mom_lb"
        }
      },
      "op": "gt",
      "threshold": {
        "param": "mom_floor"
      }
    }
  ],
  "exit": {
    "stop_loss": {
      "param": "stop"
    },
    "take_profit": {
      "param": "tp"
    },
    "time_stop_days": {
      "param": "time_stop"
    },
    "signal_exits": [
      {
        "feature": {
          "name": "fear_greed"
        },
        "op": "lt",
        "threshold": {
          "param": "greed_exit"
        }
      }
    ]
  },
  "risk": {
    "max_concurrent_positions": 5,
    "max_position_pct": 0.2,
    "conviction": 0.5
  },
  "param_space": {
    "greed_floor": {
      "kind": "float",
      "lo": 55,
      "hi": 72
    },
    "greed_exit": {
      "kind": "float",
      "lo": 38,
      "hi": 50
    },
    "vol_ceiling": {
      "kind": "float",
      "lo": 0.02,
      "hi": 0.06
    },
    "mom_floor": {
      "kind": "float",
      "lo": 0.0,
      "hi": 0.03
    },
    "mom_lb": {
      "kind": "int",
      "lo": 4,
      "hi": 10,
      "step": 1
    },
    "stop": {
      "kind": "float",
      "lo": 0.05,
      "hi": 0.18
    },
    "tp": {
      "kind": "float",
      "lo": 0.1,
      "hi": 0.38
    },
    "time_stop": {
      "kind": "int",
      "lo": 4,
      "hi": 18,
      "step": 1
    }
  },
  "direction": 1,
  "funding_feature": null
}