{
  "name": "bbz_revert_lowvix_calm_stretch",
  "rationale": "A deep bb_z stretch below the band during a CALM macro-vol regime (low vix_level) is a liquidity air-pocket that reverts, not a vol-driven trend break. Disconfirmer: entry requires vix_level below the calm threshold; if the same bb_z cross_up reverts just as well when vix_level is high, the low-vol gate is inert and this collapses to generic mean reversion.",
  "catalyst": "bb_z recovers up through the lower band while vix_level is below the calm cap",
  "universe": {
    "venues": [
      "binance"
    ],
    "asset_classes": [
      "crypto"
    ],
    "min_liquidity_usd": 10000000,
    "min_instruments": 5
  },
  "horizon": {
    "bar_size": "1d",
    "min_hold_days": 2,
    "max_hold_days": 10
  },
  "entry": [
    {
      "feature": {
        "name": "bb_z"
      },
      "op": "cross_up",
      "threshold": {
        "param": "bbz_recover"
      }
    },
    {
      "feature": {
        "name": "vix_level"
      },
      "op": "lt",
      "threshold": {
        "param": "vix_calm_max"
      }
    }
  ],
  "exit": {
    "stop_loss": {
      "param": "stop"
    },
    "take_profit": {
      "param": "tp"
    },
    "time_stop_days": {
      "param": "time_stop"
    },
    "signal_exits": [
      {
        "feature": {
          "name": "bb_z"
        },
        "op": "cross_up",
        "threshold": {
          "param": "bbz_exit"
        }
      }
    ]
  },
  "risk": {
    "max_concurrent_positions": 5,
    "max_position_pct": 0.2,
    "conviction": 0.5
  },
  "param_space": {
    "bbz_recover": {
      "kind": "float",
      "lo": -2.5,
      "hi": -1.0
    },
    "vix_calm_max": {
      "kind": "float",
      "lo": 14,
      "hi": 24
    },
    "bbz_exit": {
      "kind": "float",
      "lo": 0.0,
      "hi": 1.0
    },
    "stop": {
      "kind": "float",
      "lo": 0.05,
      "hi": 0.18
    },
    "tp": {
      "kind": "float",
      "lo": 0.08,
      "hi": 0.3
    },
    "time_stop": {
      "kind": "int",
      "lo": 3,
      "hi": 15,
      "step": 1
    }
  },
  "direction": 1,
  "funding_feature": null
}