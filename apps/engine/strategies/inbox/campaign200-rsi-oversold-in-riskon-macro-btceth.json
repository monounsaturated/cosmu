{
  "name": "rsi_oversold_in_riskon_macro_btceth",
  "rationale": "Buy RSI oversold dips ONLY when the composite macro_regime is risk-on (favourable). Thesis: oversold reversions pay in benign macro and bleed in risk-off. DISCONFIRMER: an ADX<cap filter restricts entries to non-trending tape \u2014 if the edge needs high ADX it is momentum in disguise, not reversion; also if it works equally in risk-off the regime gate is decorative.",
  "catalyst": "RSI prints oversold while macro_regime sits in the favourable band",
  "universe": {
    "venues": [
      "binance"
    ],
    "asset_classes": [
      "crypto"
    ],
    "min_liquidity_usd": 10000000,
    "min_instruments": 5
  },
  "horizon": {
    "bar_size": "1d",
    "min_hold_days": 2,
    "max_hold_days": 12
  },
  "entry": [
    {
      "feature": {
        "name": "rsi"
      },
      "op": "lt",
      "threshold": {
        "param": "rsi_os"
      }
    },
    {
      "feature": {
        "name": "macro_regime"
      },
      "op": "gt",
      "threshold": {
        "param": "regime_min"
      }
    },
    {
      "feature": {
        "name": "adx"
      },
      "op": "lt",
      "threshold": {
        "param": "adx_cap"
      }
    }
  ],
  "exit": {
    "stop_loss": {
      "param": "stop"
    },
    "take_profit": {
      "param": "tp"
    },
    "time_stop_days": {
      "param": "time_stop"
    },
    "signal_exits": [
      {
        "feature": {
          "name": "rsi"
        },
        "op": "gt",
        "threshold": {
          "param": "rsi_exit"
        }
      }
    ]
  },
  "risk": {
    "max_concurrent_positions": 5,
    "max_position_pct": 0.2,
    "conviction": 0.5
  },
  "param_space": {
    "rsi_os": {
      "kind": "float",
      "lo": 20,
      "hi": 38
    },
    "regime_min": {
      "kind": "float",
      "lo": 0.0,
      "hi": 0.6
    },
    "adx_cap": {
      "kind": "float",
      "lo": 15,
      "hi": 30
    },
    "rsi_exit": {
      "kind": "float",
      "lo": 50,
      "hi": 68
    },
    "stop": {
      "kind": "float",
      "lo": 0.05,
      "hi": 0.2
    },
    "tp": {
      "kind": "float",
      "lo": 0.08,
      "hi": 0.4
    },
    "time_stop": {
      "kind": "int",
      "lo": 3,
      "hi": 25,
      "step": 1
    }
  },
  "direction": 1,
  "funding_feature": null
