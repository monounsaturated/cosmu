{
  "name": "vix_calm_momentum_orthogonality_test",
  "rationale": "If VIX-easing genuinely shifts the vol regime, it should generate upside even when recent crypto return is NEGATIVE \u2014 i.e. orthogonal to momentum. Thesis: arm long on vix_level cross_down while ret_5d is negative. Disconfirmer: the ret_5d band is forced negative \u2014 if the only way to make money is to also have positive recent returns, the strategy is momentum wearing a VIX hat; demanding a counter-trend entry is the direct control that proves the vol-easing signal stands alone.",
  "catalyst": "VIX eases while recent return is negative",
  "universe": {
    "venues": [
      "binance"
    ],
    "asset_classes": [
      "crypto"
    ],
    "min_liquidity_usd": 10000000,
    "min_instruments": 5
  },
  "horizon": {
    "bar_size": "1d",
    "min_hold_days": 3,
    "max_hold_days": 16
  },
  "entry": [
    {
      "feature": {
        "name": "vix_level"
      },
      "op": "cross_down",
      "threshold": {
        "param": "vix_cross"
      }
    },
    {
      "feature": {
        "name": "ret_Nd",
        "lookback": {
          "param": "ret_lb"
        }
      },
      "op": "between",
      "threshold": {
        "param": "ret_band"
      }
    }
  ],
  "exit": {
    "stop_loss": {
      "param": "stop"
    },
    "take_profit": {
      "param": "tp"
    },
    "time_stop_days": {
      "param": "time_stop"
    },
    "signal_exits": []
  },
  "risk": {
    "max_concurrent_positions": 5,
    "max_position_pct": 0.2,
    "conviction": 0.5
  },
  "param_space": {
    "vix_cross": {
      "kind": "float",
      "lo": 15.0,
      "hi": 27.0
    },
    "ret_lb": {
      "kind": "int",
      "lo": 3,
      "hi": 7,
      "step": 1
    },
    "ret_band": {
      "kind": "float",
      "lo": -0.15,
      "hi": 0.0
    },
    "stop": {
      "kind": "float",
      "lo": 0.05,
      "hi": 0.2
    },
    "tp": {
      "kind": "float",
      "lo": 0.08,
      "hi": 0.35
    },
    "time_stop": {
      "kind": "int",
      "lo": 4,
      "hi": 16,
      "step": 1
    }
  },
  "direction": 1,
  "funding_feature": null
}