# ╔════════════════════════════════════════════════════════════════════════════╗
# ║  COSMU .env  —  copy this file to  .env.local  (gitignored) and fill it in.  ║
# ╚════════════════════════════════════════════════════════════════════════════╝
#
#  MINIMUM TO RUN (fill these 5, the rest are optional):
#     DATABASE_URL          ← Supabase (EU region)
#     XAI_API_KEY           ← Twitter/X data
#     OPENROUTER_API_KEY    ← the 24/7 LLM loop (free models by default)
#     MODAL_TOKEN_ID        ← heavy compute
#     MODAL_TOKEN_SECRET    ←
#
#  Each key lives in up to 3 places — keep them in sync:
#     • .env.local        → the SOURCE you fill (local dev + `modal run` auth)
#     • Railway dashboard → the always-on backend
#     • Modal secret      → run  `pnpm modal:secret`  to push them (no hand-typing)
#
#  The FREE gate runs with ZERO keys. Keys only unlock paid/LLM/extra-data paths.
#  Operator = FR/EU → prefer EU regions for Supabase + Railway.


# ─────────────────────────────  DATABASE (Supabase)  ─────────────────────────────
# Transaction pooler, port 6543. Keep the format; URL-encode the password; no [ ] brackets.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cosmu
# false for a local non-SSL Postgres; true/empty for the Supabase pooler.
DATABASE_SSL=false

# ─────────────────────────────  ENV PROFILE (APP_ENV)  ─────────────────────────────
# APP_ENV picks WHICH env file the engine loads (and maps to the typed `environment`):
#   dev        → .env.local        (default; maps to environment=local)
#   test       → .env.test.local   (sqlite, NO keys; maps to environment=test)
#   qa         → .env.qa.local     (supabase placeholder; maps to environment=production)
#   production → NO file at all — process env only (secrets injected by the platform, never committed)
# The FREE cross-asset gate (POST /research/cross-asset-gate) needs ZERO API keys to run — the
# synthetic fallback runs offline, and every free provider (Kraken/Bybit/Yahoo/Coinglass/CBOE/GDELT)
# is keyless. Keys below are only for the paid/LLM paths.
APP_ENV=dev

# ====== CONFIGURATION GLOBALE ======
API_PORT=4000
# Server-only URL used by Next.js routes/server components to call the Railway API.
API_BASE_URL=http://localhost:4000

# ====== SÉCURITÉ & CORS ======
# Remplace par une vraie clé secrète en production (min 32 chars)
API_SECRET_KEY=cle_secrete_de_developpement_locale_tres_longue

# Optional. One production/custom origin, or leave empty (Vercel previews are still allowed — see README).
WEB_BASE_URL=
# Optional. Comma-separated extra allowed browser origins (e.g. custom domain on Vercel).
# CORS_EXTRA_ORIGINS=https://app.example.com
# Default: allow https://*.vercel.app previews. Set to false to disable.
# CORS_ALLOW_VERCEL_PREVIEWS=true
# Optional. Same as old "open CORS" when WEB_BASE_URL was unset — not recommended for public APIs.
# CORS_ALLOW_ANY_ORIGIN=false

# ====== APIS EXTERNES ======
# xAI (Grok). RESERVED FOR ON-DEMAND USE: the scheduled crons never auto-spend it (they route to OpenRouter
# ":free") so the small xAI credit is preserved for on-demand tweet ingestion. Set XAI_SCHEDULED_ENABLED=1
# below to let the unattended crons author/score with Grok again.
XAI_API_KEY=
# Optional. Default off → xAI is on-demand only. Set to 1/true to re-arm scheduled xAI spend (author, index
# rubric scoring, ingest tweet LiveSearch, research live_search). Goes in: .env.local + Railway + Modal secret.
XAI_SCHEDULED_ENABLED=
NOUS_API_KEY=
# Optional. Defaults to https://portal.nousresearch.com/v1
NOUS_BASE_URL=
OPENAI_API_KEY=
# Optional. Leave blank for OpenAI default.
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
# Optional. Defaults to https://api.anthropic.com/v1
ANTHROPIC_BASE_URL=
HUGGINGFACE_API_KEY=
# Optional. Defaults to https://router.huggingface.co/v1
HUGGINGFACE_BASE_URL=

# ====== ALT-DATA, LLM ROUTER & SIGNAL KEYS ======
# OpenRouter: one gateway, many models (Qwen/DeepSeek/Grok/Claude/GPT). `:free` tier by default.
# Optional fallback when XAI_API_KEY is unset. Goes in: .env.local + Railway + Modal secret.
OPENROUTER_API_KEY=
# FRED (free key): macro series (rates, yields, DXY, credit spreads). https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# LunarCrush (PAID plan as of 2026 — no free tier): social/sentiment feed. The provider is already wired;
# setting this key activates the Social pillar + lunarcrush features. Empty = degrades honestly (returns []).
LUNARCRUSH_API_KEY=
# Polymarket: a real market token id (NOT a secret) → prediction-market odds usable as features now.
POLYMARKET_TOKEN=
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Testnet keys (from https://testnet.binance.vision/) — used when bot mode=testnet
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
# ─── LIVE EXEC KEYS (optional — only set when ARMING a venue for real money) ───
# These unlock REAL orders on a venue. Empty = the venue's exec adapter stays DISABLED → sim-fills
# (honest degradation; never real money by accident). Arming is a deliberate, human-gated step on top of
# adding the key — see docs/runbooks/kraken-live-arming.md. NO real keys in this file; .env.local only.
# Kraken SPOT (crypto). No public sandbox → the only modes are disabled (no keys) and live (keys +
# LIVE__MODE=real). Create the pair in Kraken → Settings → API (orders + query perms, NOT withdraw).
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
# Polymarket LIVE exec (CLOB on Polygon, USDC). The SIGNING KEY is the only thing that unlocks real orders
# (with LIVE__MODE=real). The L2 creds below are derived from it by py-clob-client when omitted. The Amoy
# TESTNET signing key takes precedence and never touches real funds. (POLYMARKET_TOKEN above is a market id
# for odds-as-features and is NOT a credential.)
POLYMARKET_PRIVATE_KEY=
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_PASSPHRASE=
POLYMARKET_FUNDER_ADDRESS=
POLYMARKET_TESTNET_PRIVATE_KEY=
# The real-money interlock for ALL venues above: stays 'testnet' (default) until you DELIBERATELY arm.
# Only LIVE__MODE=real lets a present key reach a production exchange — and even then only with the global
# live toggle ON + a gate-passed, paper-proven survivor + caps available + no kill-switch (the 5 interlocks).
# LIVE__MODE=real
SLACK_WEBHOOK_URL=

# ====== MODAL (HEAVY-COMPUTE LANE) ======
# Lets `modal run` authenticate non-interactively (Claude Code / cloud sessions). Get them from
# https://modal.com/settings/tokens. For a normal laptop you can instead just run `modal setup` once
# (writes ~/.modal.toml) and leave these blank.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# NOTE: the RUNTIME keys the Modal jobs use (DATABASE_URL, XAI_API_KEY, FRED_API_KEY, …) are NOT read from
# this file by Modal — they live in the Modal secret `cosmu-engine`. Sync them from .env.local in one step:
#   python3 scripts/sync_modal_secret.py   (alias: pnpm modal:secret)
