# ====== PROFIL TEST (APP_ENV=test) — TEMPLATE ======
# Copy to .env.test.local (gitignored, stays local) when you want a hermetic test profile.
# Goal: a hermetic, offline test profile — sqlite + NO API keys.
# The free cross-asset gate needs ZERO keys, so this file deliberately leaves every key blank.

# Local sqlite — no Postgres/Supabase needed for tests.
DATABASE_URL=sqlite:///./.cosmu/cosmu.test.sqlite3
DATABASE_SSL=false

# A throwaway secret so the API boots; never a real one.
API_SECRET_KEY=test_secret_key_not_for_production_at_least_32_chars

# ====== APIS EXTERNES — ALL BLANK ON PURPOSE (free path only) ======
XAI_API_KEY=
NOUS_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HUGGINGFACE_API_KEY=
OPENROUTER_API_KEY=
LUNARCRUSH_API_KEY=
BINANCE_API_KEY=
BINANCE_API_SECRET=
