# ====== PROFIL QA (APP_ENV=qa) — TEMPLATE ======
# Copy to .env.qa.local (gitignored, stays local) and fill from your QA secret manager.
# Goal: a staging profile that mirrors production wiring (Supabase Postgres) WITHOUT real prod secrets.
# QA maps to environment=production in the typed Settings, so it exercises the prod code paths.

# Supabase Transaction pooler placeholder (port 6543). URL-encode the password; no brackets.
DATABASE_URL=postgresql://postgres:CHANGE_ME@db.CHANGE_ME.supabase.co:6543/postgres
DATABASE_SSL=true

# Replace with a real 32+ char secret in the QA secret manager — placeholder only here.
API_SECRET_KEY=CHANGE_ME_qa_secret_key_min_32_characters_long

# ====== APIS EXTERNES ======
# The free cross-asset gate needs ZERO keys; these may stay blank and QA runs the keyless free path.
XAI_API_KEY=
NOUS_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HUGGINGFACE_API_KEY=
OPENROUTER_API_KEY=
LUNARCRUSH_API_KEY=
BINANCE_API_KEY=
BINANCE_API_SECRET=
