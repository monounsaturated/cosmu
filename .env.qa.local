# ====== PROFIL QA (APP_ENV=qa) ======
# Loaded when APP_ENV=qa. Goal: a staging profile that mirrors production wiring (Supabase Postgres)
# WITHOUT real production secrets. Fill the placeholders locally; do NOT commit real values.
# QA maps to environment=production in the typed Settings, so it exercises the prod code paths.

# Supabase Transaction pooler placeholder (port 6543). URL-encode the password; no brackets.
DATABASE_URL=postgresql://postgres:CHANGE_ME@db.CHANGE_ME.supabase.co:6543/postgres
# Leave true/empty for the Supabase pooler (SSL on).
DATABASE_SSL=true

# Replace with a real 32+ char secret in the QA secret manager — placeholder only here.
API_SECRET_KEY=CHANGE_ME_qa_secret_key_min_32_characters_long

# ====== APIS EXTERNES ======
# QA can exercise paid/LLM paths; fill from the QA secret manager. The free cross-asset gate still
# needs ZERO keys, so these may stay blank and QA will run the keyless free path.
XAI_API_KEY=
NOUS_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HUGGINGFACE_API_KEY=
OPENROUTER_API_KEY=
LUNARCRUSH_API_KEY=
BINANCE_API_KEY=
BINANCE_API_SECRET=
